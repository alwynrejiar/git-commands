GIT COMMAND

>? LOCAL REPOSITORY (GIT)?<

git config --global user.name "user_name"
git config --global user.email "email_id"


git init -- for initlizing
git status --for listing untracked files
git add . --for adding untracked files
git commit -m "commit message" -- to add the files into local repository


>? REOMTE REPOSITORY (GITHUB)?<

git log --for commit history
git remote -v  -- for showing the details of remote repository

git remote add origin " link " -- for connecting local and remote repo
git branch(main,master) --to find if the branch name is main or master
git push origin master -- to push any changes made inn local repo